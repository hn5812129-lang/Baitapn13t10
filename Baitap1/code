        private void InitDataAndBinding()
        {
            // Khởi tạo danh sách mẫu
            listStudents = new BindingList<Student>
            {
                new Student { StudentId = "SV001", FullName = "Nguyễn Văn A", Age = 20, Gender = "Nam", AvatarPath = "" },
                new Student { StudentId = "SV002", FullName = "Trần Thị B", Age = 19, Gender = "Nữ", AvatarPath = "" }
            };

            // Khởi tạo BindingSource
            bindingSource = new BindingSource();
            bindingSource.DataSource = listStudents;

            // Gắn BindingSource cho DataGridView
            dataGridView1.DataSource = bindingSource;

            // Ràng buộc dữ liệu 2 chiều (DataBindings) giữa Control nhập liệu và BindingSource
            txtStudentId.DataBindings.Add("Text", bindingSource, "StudentId", true, DataSourceUpdateMode.OnPropertyChanged);
            txtFullName.DataBindings.Add("Text", bindingSource, "FullName", true, DataSourceUpdateMode.OnPropertyChanged);
            txtAge.DataBindings.Add("Text", bindingSource, "Age", true, DataSourceUpdateMode.OnPropertyChanged);
            cbGender.DataBindings.Add("Text", bindingSource, "Gender", true, DataSourceUpdateMode.OnPropertyChanged);

            // Sự kiện khi chuyển dòng trên DataGridView để load lại ảnh Avatar tương ứng
            bindingSource.CurrentChanged += BindingSource_CurrentChanged;

            // Load ảnh cho dòng đầu tiên
            LoadCurrentAvatar();
        }

        private void BindingSource_CurrentChanged(object sender, EventArgs e)
        {
            LoadCurrentAvatar();
        }

        private void LoadCurrentAvatar()
        {
            if (bindingSource.Current is Student currentStudent)
            {
                if (!string.IsNullOrEmpty(currentStudent.AvatarPath) && File.Exists(currentStudent.AvatarPath))
                {
                    try
                    {
                        using (var stream = new FileStream(currentStudent.AvatarPath, FileMode.Open, FileAccess.Read))
                        {
                            pictureBoxAvatar.Image = Image.FromStream(stream);
                        }
                    }
                    catch
                    {
                        pictureBoxAvatar.Image = null;
                    }
                }
                else
                {
                    pictureBoxAvatar.Image = null;
                }
            }
            else
            {
                pictureBoxAvatar.Image = null;
            }
        }

        // Chọn ảnh Avatar (.jpg, .png, .bmp)
        private void btnChonAnh_Click(object sender, EventArgs e)
        {
            using (OpenFileDialog ofd = new OpenFileDialog())
            {
                ofd.Filter = "Image Files|*.jpg;*.jpeg;*.png;*.bmp";
                if (ofd.ShowDialog() == DialogResult.OK)
                {
                    if (bindingSource.Current is Student currentStudent)
                    {
                        currentStudent.AvatarPath = ofd.FileName;
                        LoadCurrentAvatar();
                        bindingSource.ResetCurrentItem();
                    }
                }
            }
        }

        // Thêm sinh viên mới
        private void btnThem_Click(object sender, EventArgs e)
        {
            if (string.IsNullOrWhiteSpace(txtStudentId.Text))
            {
                MessageBox.Show("Vui lòng nhập Mã sinh viên!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            int.TryParse(txtAge.Text, out int age);

            Student newStudent = new Student
            {
                StudentId = txtStudentId.Text.Trim(),
                FullName = txtFullName.Text.Trim(),
                Age = age,
                Gender = cbGender.Text,
                AvatarPath = pictureBoxAvatar.Image != null && bindingSource.Current is Student s ? s.AvatarPath : ""
            };

            listStudents.Add(newStudent);
            bindingSource.Position = listStudents.Count - 1;
            MessageBox.Show("Thêm sinh viên thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        // Xóa sinh viên đang chọn
        private void btnXoa_Click(object sender, EventArgs e)
        {
            if (bindingSource.Current is Student currentStudent)
            {
                var confirm = MessageBox.Show($"Bạn có chắc chắn muốn xóa sinh viên {currentStudent.FullName}?", "Xác nhận xóa", MessageBoxButtons.YesNo, MessageBoxIcon.Question);
                if (confirm == DialogResult.Yes)
                {
                    bindingSource.RemoveCurrent();
                    MessageBox.Show("Đã xóa thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                }
            }
            else
            {
                MessageBox.Show("Không có sinh viên nào được chọn để xóa!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Warning);
            }
        }

        // Cập nhật thông tin
