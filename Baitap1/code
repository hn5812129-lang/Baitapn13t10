            MessageBox.Show("Cập nhật thông tin thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
        }

        // Xuất file CSV (Hỗ trợ tiếng Việt UTF-8 chuẩn có BOM)
        private void btnXuatCSV_Click(object sender, EventArgs e)
        {
            using (SaveFileDialog sfd = new SaveFileDialog())
            {
                sfd.Filter = "CSV file (*.csv)|*.csv";
                sfd.FileName = "DanhSachSinhVien.csv";

                if (sfd.ShowDialog() == DialogResult.OK)
                {
                    try
                    {
                        using (StreamWriter sw = new StreamWriter(sfd.FileName, false, new UTF8Encoding(true)))
                        {
                            // Ghi tiêu đề cột
                            sw.WriteLine("StudentId,FullName,Age,Gender,AvatarPath");

                            // Ghi dữ liệu
                            foreach (var st in listStudents)
                            {
                                string line = $"{st.StudentId},\"{st.FullName}\",{st.Age},{st.Gender},\"{st.AvatarPath}\"";
                                sw.WriteLine(line);
                            }
                        }

                        MessageBox.Show("Xuất file CSV thành công!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    }
                    catch (Exception ex)
                    {
                        MessageBox.Show($"Lỗi khi xuất file: {ex.Message}", "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    }
                }
            }
        }
