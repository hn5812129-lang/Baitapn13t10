using System;
using System.ComponentModel;
using System.Drawing;
using System.IO;
using System.Text;
using System.Windows.Forms;

namespace WinFormsApp7
{
    public partial class Form1 : Form
    {
        private MenuStrip menuStripMain;
        private ToolStrip toolStripMain;
        private StatusStrip statusStripMain;
        private ToolStripStatusLabel lblStatusMessage;
        private ToolStripStatusLabel lblTime;
        private System.Windows.Forms.Timer timerClock; // Chỉ định rõ Timer của Windows Forms

        public Form1()
        {
            this.IsMdiContainer = true;
            this.Width = 1100;
            this.Height = 700;
            this.Text = "Hệ thống Quản lý Đa cửa sổ (MDI Parent)";
            this.StartPosition = FormStartPosition.CenterScreen;

            InitializeMdiFramework();
        }

        private void InitializeMdiFramework()
        {
            menuStripMain = new MenuStrip();

            ToolStripMenuItem menuHeThong = new ToolStripMenuItem("Hệ thống");
            ToolStripMenuItem itemDangXuat = new ToolStripMenuItem("Đăng xuất", null, (s, e) => {
                MessageBox.Show("Đã đăng xuất hệ thống!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                UpdateStatus("Hệ thống: Người dùng đã đăng xuất.");
            });
            ToolStripMenuItem itemThoat = new ToolStripMenuItem("Thoát", null, (s, e) => Application.Exit());
            menuHeThong.DropDownItems.Add(itemDangXuat);
            menuHeThong.DropDownItems.Add(new ToolStripSeparator());
            menuHeThong.DropDownItems.Add(itemThoat);

            ToolStripMenuItem menuDanhMuc = new ToolStripMenuItem("Danh mục");
            ToolStripMenuItem itemQuanLySV = new ToolStripMenuItem("Quản lý Sinh viên", null, (s, e) => OpenChildForm<FormStudent>());
            ToolStripMenuItem itemQuanLySP = new ToolStripMenuItem("Quản lý Sản phẩm", null, (s, e) => {
                MessageBox.Show("Chức năng Quản lý Sản phẩm đang phát triển!", "Thông báo", MessageBoxButtons.OK, MessageBoxIcon.Information);
                UpdateStatus("Đã mở chức năng: Quản lý Sản phẩm.");
            });
            menuDanhMuc.DropDownItems.Add(itemQuanLySV);
            menuDanhMuc.DropDownItems.Add(itemQuanLySP);

            ToolStripMenuItem menuCuaSo = new ToolStripMenuItem("Cửa sổ");
            ToolStripMenuItem itemCascade = new ToolStripMenuItem("Cascade (Xếp chồng)", null, (s, e) => this.LayoutMdi(MdiLayout.Cascade));
            ToolStripMenuItem itemTileH = new ToolStripMenuItem("Tile Horizontal (Ngang)", null, (s, e) => this.LayoutMdi(MdiLayout.TileHorizontal));
            ToolStripMenuItem itemTileV = new ToolStripMenuItem("Tile Vertical (Dọc)", null, (s, e) => this.LayoutMdi(MdiLayout.TileVertical));
            menuCuaSo.DropDownItems.AddRange(new ToolStripItem[] { itemCascade, itemTileH, itemTileV });

            menuStripMain.Items.AddRange(new ToolStripItem[] { menuHeThong, menuDanhMuc, menuCuaSo });
            this.MainMenuStrip = menuStripMain;
            this.Controls.Add(menuStripMain);

            toolStripMain = new ToolStrip();
            ToolStripButton btnShortcutSV = new ToolStripButton("Quản lý Sinh viên", null, (s, e) => OpenChildForm<FormStudent>());
            toolStripMain.Items.Add(btnShortcutSV);
            this.Controls.Add(toolStripMain);

            statusStripMain = new StatusStrip();
            lblStatusMessage = new ToolStripStatusLabel("Trạng thái: Sẵn sàng | Người dùng: Hiếu");
            lblStatusMessage.Spring = true;
            lblStatusMessage.TextAlign = ContentAlignment.MiddleLeft;

            lblTime = new ToolStripStatusLabel();
            statusStripMain.Items.AddRange(new ToolStripItem[] { lblStatusMessage, lblTime });
            this.Controls.Add(statusStripMain);

            timerClock = new System.Windows.Forms.Timer();
            timerClock.Interval = 1000;
            timerClock.Tick += (s, e) => { lblTime.Text = DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss"); };
            timerClock.Start();
        }

        private void OpenChildForm<T>() where T : Form, new()
        {
            foreach (Form child in this.MdiChildren)
            {
                if (child is T)
                {
                    child.Activate();
                    UpdateStatus($"Đã kích hoạt cửa sổ: {child.Text}");
                    return;
                }
            }

            T newForm = new T();
            newForm.MdiParent = this;

            if (newForm is FormStudent studentForm)
            {
                studentForm.OnStatusMessageChanged += (msg) => UpdateStatus(msg);
            }

            newForm.Show();
            UpdateStatus($"Đã mở cửa sổ mới: {newForm.Text}");
        }

        public void UpdateStatus(string message)
        {
            lblStatusMessage.Text = $"Trạng thái: {message}";
        }
    }

    // ==========================================
    // MDI CHILD: FORM QUẢN LÝ SINH VIÊN (FormStudent)
    // ==========================================
    public class FormStudent : Form
    {
        public class Student
        {
            public string StudentId { get; set; } = string.Empty;
            public string FullName { get; set; } = string.Empty;
            public int Age { get; set; }
            public string Gender { get; set; } = string.Empty;
            public string AvatarPath { get; set; } = string.Empty;
        }

        private DataGridView dataGridView1 = null!;
        private TextBox txtStudentId = null!;
        private TextBox txtFullName = null!;
        private TextBox txtAge = null!;
        private ComboBox cbGender = null!;
        private PictureBox pictureBoxAvatar = null!;
        private Button btnThem = null!;
        private Button btnXoa = null!;
        private Button btnCapNhat = null!;
        private ContextMenuStrip contextMenuGrid = null!;

        private BindingList<Student> listStudents = null!;
        private BindingSource bindingSource = null!;

        public event Action<string> OnStatusMessageChanged = null!;

        public FormStudent()
        {
            this.Text = "Quản lý Sinh viên";
            this.Width = 850;
            this.Height = 520;

            InitializeCustomComponents();
            InitDataAndBinding();
        }

        private void InitializeCustomComponents()
        {
            dataGridView1 = new DataGridView();
            dataGridView1.Location = new Point(15, 15);
            dataGridView1.Size = new Size(500, 430);
            dataGridView1.AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill;
            dataGridView1.SelectionMode = DataGridViewSelectionMode.FullRowSelect;
            dataGridView1.ReadOnly = true;

            contextMenuGrid = new ContextMenuStrip();
            ToolStripMenuItem ctxXoa = new ToolStripMenuItem("Xóa dòng này", null, (s, e) => btnXoa_Click(s, e));
            ToolStripMenuItem ctxLamMoi = new ToolStripMenuItem("Làm mới dữ liệu", null, (s, e) => {
                bindingSource.ResetBindings(false);
                OnStatusMessageChanged?.Invoke("Đã làm mới dữ liệu danh sách sinh viên.");
            });
            ToolStripMenuItem ctxXemChiTiet = new ToolStripMenuItem("Xem chi tiết", null, (s, e) => {
                if (bindingSource.Current is Student st)
                    MessageBox.Show($"Mã SV: {st.StudentId}\nHọ tên: {st.FullName}\nTuổi: {st.Age}\nGiới tính: {st.Gender}", "Chi tiết sinh viên");
            });
            contextMenuGrid.Items.AddRange(new ToolStripItem[] { ctxXoa, ctxLamMoi, ctxXemChiTiet });
            dataGridView1.ContextMenuStrip = contextMenuGrid;

            this.Controls.Add(dataGridView1);

            int startX = 530;
            int startY = 15;

            pictureBoxAvatar = new PictureBox();
            pictureBoxAvatar.Location = new Point(startX + 40, startY);
            pictureBoxAvatar.Size = new Size(110, 140);
            pictureBoxAvatar.SizeMode = PictureBoxSizeMode.StretchImage;
            pictureBoxAvatar.BorderStyle = BorderStyle.FixedSingle;
            this.Controls.Add(pictureBoxAvatar);

            int lblX = startX;
            int txtX = startX + 70;

            Label lbl1 = new Label() { Text = "Mã SV:", Location = new Point(lblX, startY + 160), AutoSize = true };
            txtStudentId = new TextBox() { Location = new Point(txtX, startY + 157), Size = new Size(180, 22) };
            this.Controls.Add(lbl1); this.Controls.Add(txtStudentId);

            Label lbl2 = new Label() { Text = "Họ tên:", Location = new Point(lblX, startY + 195), AutoSize = true };
            txtFullName = new TextBox() { Location = new Point(txtX, startY + 192), Size = new Size(180, 22) };
            this.Controls.Add(lbl2); this.Controls.Add(txtFullName);

            Label lbl3 = new Label() { Text = "Tuổi:", Location = new Point(lblX, startY + 230), AutoSize = true };
            txtAge = new TextBox() { Location = new Point(txtX, startY + 227), Size = new Size(180, 22) };
            this.Controls.Add(lbl3); this.Controls.Add(txtAge);

            Label lbl4 = new Label() { Text = "Giới tính:", Location = new Point(lblX, startY + 265), AutoSize = true };
            cbGender = new ComboBox() { Location = new Point(txtX, startY + 262), Size = new Size(180, 22) };
            cbGender.Items.AddRange(new string[] { "Nam", "Nữ" });
            this.Controls.Add(lbl4); this.Controls.Add(cbGender);

            int btnY = startY + 315;
            btnThem = new Button() { Text = "Thêm", Location = new Point(startX, btnY), Size = new Size(75, 35) };
            btnThem.Click += btnThem_Click;

            btnXoa = new Button() { Text = "Xóa", Location = new Point(startX + 85, btnY), Size = new Size(75, 35) };
            btnXoa.Click += btnXoa_Click;

            btnCapNhat = new Button() { Text = "Cập nhật", Location = new Point(startX + 170, btnY), Size = new Size(75, 35) };
            btnCapNhat.Click += (s, e) => {
                bindingSource.EndEdit();
                dataGridView1.Refresh();
                OnStatusMessageChanged?.Invoke("Đã cập nhật thông tin sinh viên thành công.");
            };

            this.Controls.AddRange(new Control[] { btnThem, btnXoa, btnCapNhat });
        }

        private void InitDataAndBinding()
        {
            listStudents = new BindingList<Student>
            {
                new Student { StudentId = "SV001", FullName = "Nguyễn Văn A", Age = 20, Gender = "Nam", AvatarPath = "" },
                new Student { StudentId = "SV002", FullName = "Trần Thị B", Age = 19, Gender = "Nữ", AvatarPath = "" }
            };

            bindingSource = new BindingSource();
            bindingSource.DataSource = listStudents;
            dataGridView1.DataSource = bindingSource;

            txtStudentId.DataBindings.Add("Text", bindingSource, "StudentId", true, DataSourceUpdateMode.OnPropertyChanged);
            txtFullName.DataBindings.Add("Text", bindingSource, "FullName", true, DataSourceUpdateMode.OnPropertyChanged);
            txtAge.DataBindings.Add("Text", bindingSource, "Age", true, DataSourceUpdateMode.OnPropertyChanged);
            cbGender.DataBindings.Add("Text", bindingSource, "Gender", true, DataSourceUpdateMode.OnPropertyChanged);
        }

        private void btnThem_Click(object sender, EventArgs e)
        {
            if (string.IsNullOrWhiteSpace(txtStudentId.Text)) return;
            int.TryParse(txtAge.Text, out int age);

            listStudents.Add(new Student
            {
                StudentId = txtStudentId.Text.Trim(),
                FullName = txtFullName.Text.Trim(),
                Age = age,
                Gender = cbGender.Text
            });

            bindingSource.Position = listStudents.Count - 1;
            OnStatusMessageChanged?.Invoke($"Thêm thành công sinh viên: {txtFullName.Text}");
        }

        private void btnXoa_Click(object sender, EventArgs e)
        {
            if (bindingSource.Current is Student currentStudent)
            {
                string name = currentStudent.FullName;
                bindingSource.RemoveCurrent();
                OnStatusMessageChanged?.Invoke($"Đã xóa sinh viên: {name}");
            }
        }
    }
}
